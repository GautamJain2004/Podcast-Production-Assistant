# Google Gemini Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Serper API Configuration (for web search)
# Get your API key from: https://serper.dev/
SERPER_API_KEY=your_serper_api_key_here
WEB_SEARCH_ENGINE=google
SEARCH_RESULTS_COUNT=5
SEARCH_LANGUAGE=en
SEARCH_COUNTRY=us

# Application Settings
APP_NAME=Podcast Production Suite
LOG_LEVEL=INFO
MAX_RESEARCH_ITEMS=5
MAX_SOCIAL_POSTS=3

# MCP Server Configuration (for future use)
MCP_WEB_SEARCH_SERVER_PATH=path/to/web-search-server
MCP_AUDIO_TOOL_SERVER_PATH=path/to/audio-tool-server

# Audio Settings
WORDS_PER_MINUTE=150

# YouTube API (Optional - for video search)
# Get your key from: https://console.cloud.google.com/
# Enable "YouTube Data API v3" and create an API key
# Note: Transcript extraction works WITHOUT this key
YOUTUBE_API_KEY=
